<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <showApprovalHistory>true</showApprovalHistory>
    <label>Event Approval Process</label>
    <description>Standard administrative approval process for published events.</description>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <finalApprovalActions>
        <action>
            <name>Set_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalRejectionActions>
        <action>
            <name>Set_Status_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <initialSubmissionActions>
        <action>
            <name>Set_Status_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
</ApprovalProcess>
